          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Workflow response checks">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
try {
  def label = prev.getSampleLabel()
  if (label == 'Negative login') {
    def ok = prev.getResponseCode() in ['401', '403']
    prev.setSuccessful(ok)
    assert ok : 'Expected HTTP 401 or 403'
    return
  }
  assert prev.getResponseCode() == '200' : 'Expected HTTP 200'
  def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
  def id = vars.get('product_id').toInteger()
  def qty = vars.get('quantity').toInteger()
  switch (label) {
    case '01 Login':
      assert json.token instanceof String &amp;&amp; json.token.trim() &amp;&amp; json.user?.id != null
      assert vars.get('token') == json.token &amp;&amp; vars.get('user_id') == json.user.id.toString()
      vars.put('login_ok', 'true'); break
    case '02 Products':
      assert json instanceof List &amp;&amp; json.any { it.id == id }; break
    case '03 Product detail':
      assert json instanceof Map &amp;&amp; json.id == id &amp;&amp; json.name instanceof String &amp;&amp; json.name.trim()
      def price = new BigDecimal(json.price.toString()); assert price &gt; 0
      vars.put('total_amount', price.multiply(new BigDecimal(qty)).toPlainString())
      vars.put('cart_body', JsonOutput.toJson([id:id, name:json.name, price:price, quantity:qty]))
      vars.put('detail_ok','true'); break
    case '04 Add cart':
      assert json.message == 'Added to cart'; vars.put('cart_ok','true'); break
    case '05 Get cart':
      assert json instanceof List &amp;&amp; json &amp;&amp; json[-1].id == id &amp;&amp; json[-1].quantity == qty; break
    case '06 Checkout':
      assert json.orderId instanceof Number &amp;&amp; json.orderId.toString() ==~ /[1-9][0-9]*/
      assert vars.get('order_id') == json.orderId.toString()
      vars.put('checkout_ok','true'); break
    case '07 My orders':
      assert json instanceof List &amp;&amp; json.any { it.id.toString() == vars.get('order_id') &amp;&amp; it.user_id.toString() == vars.get('user_id') &amp;&amp; new BigDecimal(it.total_amount.toString()).compareTo(new BigDecimal(vars.get('total_amount'))) == 0 }; break
    default: assert false : 'No check for label ' + label
  }
} catch (Throwable e) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(e.toString())
}
finally {
  if (prev.getSampleLabel() != 'Negative login') {
    synchronized (props) {
      def stage = props.get('stress.run')?.stages?.get(ctx.getThreadGroup().getName())
      if (stage != null) {
        stage.elapsed.add(prev.getTime())
        if (!prev.isSuccessful() || AssertionResult.isFailure() || AssertionResult.isError()) stage.fail++
      }
    }
  }
}
</stringProp>
          </JSR223Assertion>
