      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Stress stage 3">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(loops,-1)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__groovy((props.get('loops'\,'-1') == '-1' || props.get('stage_smoke'\,'false') == 'true') ? props.get('threads'\,'200') : '0')}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,30)}</stringProp>
        <stringProp name="ThreadGroup.scheduler">${__groovy(props.get('loops'\,'-1') == '-1')}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,150)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
      </ThreadGroup>
      <hashTree>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Evaluate previous stage before HTTP" />
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Stress boundary gate (not recorded)">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">SampleResult.setIgnore()
synchronized (props) {
  def run = props.get('stress.run')
  if (run == null) { run = [stages:[:], allowed:[:]]; props.put('stress.run', run) }
  def stage = ctx.getThreadGroup().getName()
  if (!run.allowed.containsKey(stage)) {
    int index = Integer.parseInt(stage.substring(stage.length()-1))
    boolean allowed = true
    if (index &gt; 1) {
      def previous = run.stages['Stress stage '+(index-1)]
      if (!previous || previous.elapsed.isEmpty()) allowed = false
      else {
        def ordered = previous.elapsed.sort(false)
        long p95 = ordered[(int)Math.ceil(ordered.size()*0.95)-1]
        double error = 100.0*previous.fail/ordered.size()
        allowed = error &lt;= 5.0 &amp;&amp; p95 &lt;= 2000
        log.info('STRESS_GATE previous={} samples={} errors={} p95_ms={} continue={}', index-1, ordered.size(), error, p95, allowed)
      }
    }
    run.allowed[stage] = allowed
    run.stages[stage] = [start:System.currentTimeMillis(), elapsed:[], fail:0]
    log.info('STRESS_STAGE_START stage={} timestamp={} allowed={}', stage, run.stages[stage].start, allowed)
  }
  vars.put('gate_ok', run.allowed[stage].toString())
}
if (vars.get('gate_ok') != 'true') ctx.getEngine().stopTest(false)
</stringProp>
