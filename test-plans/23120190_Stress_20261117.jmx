          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Keep account and reset iteration">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (!vars.get('account_email')) {
  def accounts = props.computeIfAbsent('stress.accounts.4') { java.util.Collections.synchronizedSet(new HashSet()) }
  synchronized (accounts) {
    def email = vars.get('main_email'); def password = vars.get('main_password')
    if (accounts.contains(email)) {
      def rows = new File('data/users_main.csv').readLines('UTF-8').drop(1).collect { it.split(',', -1) }
      def row = rows.find { !accounts.contains(it[0]) }
      if (!row) throw new IllegalStateException('Not enough main accounts for active VUs')
      email = row[0]; password = row[1]
    }
    accounts.add(email); vars.put('account_email', email); vars.put('account_password', password)
  }
}
['token','user_id','order_id','detail_name','detail_price','total_amount','login_ok','detail_ok','cart_ok','checkout_ok'].each { vars.remove(it) }</stringProp>
