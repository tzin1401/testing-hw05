{
  "name": "auth",
  "description": "Auth-heavy: log in every iteration, read own profile; 5% wrong-password logins on lock accounts (401/403 expected).",
  "csv": [
    {"file": "data/users_main.csv", "vars": "email,password"},
    {"file": "data/users_lock.csv", "vars": "lock_email,lock_password"}
  ],
  "steps": [
    {"label": "A1 Login", "method": "POST", "path": "/api/login",
     "body": {"email": "${email}", "password": "${password}"}, "expect": "200", "extract": {"token": "$.token"}},
    {"label": "A2 Get profile", "method": "GET", "path": "/api/users/me", "auth": true, "expect": "200"},
    {"label": "A3 Negative login", "method": "POST", "path": "/api/login", "percent": 5, "slo": false,
     "body": {"email": "${lock_email}", "password": "${lock_password}"}, "expect": "401|403"}
  ],
  "slo": {"p95_ms": 75, "error_pct": 0.1},
  "think_ms": [500, 1500]
}
